# Variables de entorno para producción (configúralas en el Dashboard de Render,
# sección "Environment" del Web Service — este archivo es solo referencia, no lleva valores reales)

# Con la base dentro de Render: la "Internal Address" del Private Service, sin :3306
DB_HOST=planeacion-mysql-xxxx
DB_PORT=3306
DB_NAME=planeacion_municipal
DB_USER=planeacion
DB_PASS=tu_password

# Clave de la vista pública de solo lectura avance.php (avance.php?clave=...).
# Usa una frase larga que no sea fácil de adivinar. Si no se configura, avance.php queda cerrada.
CLAVE_AVANCE=una-clave-larga-y-dificil

# Evidencias (fotos y PDF). Crea una cuenta gratis en https://cloudinary.com y copia
# del Dashboard la "API environment variable" completa. Sin esta variable no se pueden subir evidencias.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
